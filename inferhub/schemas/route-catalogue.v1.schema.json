{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/Pukujan/inference-recommendation-engine/blob/main/operational/telemetry/gravebuster/pipeline/ihub/schemas/route-catalogue.v1.schema.json",
 "title": "ihub-route-catalogue/v1",

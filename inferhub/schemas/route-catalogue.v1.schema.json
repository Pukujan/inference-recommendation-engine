 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema",
  "schema_file",
  "hypothesis_notice",
  "generated_at",
  "code_commit",
  "evidence",
  "method",
  "status_counts",
  "models",
  "routes"
 ],
 "properties": {
  "schema": {
   "const": "ihub-route-catalogue/v1"
  },
  "schema_file": {
   "type": "string"
  },
  "hypothesis_notice": {
   "type": "string"
  },
  "generated_at": {
   "type": "string",
   "description": "UTC time the artifact was written."
  },
  "code_commit": {
   "type": [
    "string",
    "null"
   ],

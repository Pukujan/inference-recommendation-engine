      "object",
      "null"
     ],
     "properties": {
      "dir": {
       "type": [
        "string",
        "null"
       ]
      },
      "run_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "built_at": {
       "type": [
        "string",
        "null"
       ]
      }
     }
    },
    "latest_catalog_fetch": {
     "type": [
      "object",
      "null"
     ],
     "description": "Last successful /api/catalog fetch: raw body sha256 = snapshot hash of the order book.",
     "properties": {
      "fetched_at": {
       "type": [
        "string",
        "null"
       ]

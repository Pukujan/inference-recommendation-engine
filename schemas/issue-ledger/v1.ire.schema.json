{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inference-recommendation-engine.local/schemas/issue-ledger/v1.ire.schema.json",
  "title": "Inference Recommendation Engine Read-only Issue Input v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_hash", "window", "issues"],
  "properties": {
    "schema_version": {"const": "ire/issue-ledger/v1"},
    "policy_hash": {"type": "string", "minLength": 1},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to", "days"],
      "properties": {
        "from": {"type": ["string", "null"], "format": "date-time"},
        "to": {"type": ["string", "null"], "format": "date-time"},
        "days": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id", "subject", "fingerprint", "evidence_level", "report_count",
          "distinct_execution_count", "distinct_actor_count", "distinct_correlation_count",
          "independent_reproduction_count", "lifecycle", "diagnostics", "reproduction",
          "resolution", "valid_from", "known_at", "source_event_refs", "policy_hash", "window"
        ],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": ["provider", "route", "operation", "workload_class"],
            "properties": {
              "provider": {"type": "string", "minLength": 1},
              "route": {"type": "string", "minLength": 1},
              "model": {"type": ["string", "null"]},
              "operation": {"type": "string", "minLength": 1},
              "workload_class": {"type": "string", "minLength": 1},
              "agent_harness": {"type": ["string", "null"]},
              "stream_mode": {"type": ["string", "null"]},
              "configuration_hash": {"type": ["string", "null"]},
              "environment_hash": {"type": ["string", "null"]}
            }
          },
          "fingerprint": {
            "type": "object",
            "additionalProperties": false,
            "required": ["version", "value", "components"],
            "properties": {
              "version": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1},
              "components": {"type": "object", "additionalProperties": {"type": ["string", "null"]}}
            }
          },
          "evidence_level": {"enum": ["accepted", "retracted", "independently_corroborated", "operationally_reproduced", "receipt_backed", "reported_only", "observed_once", "replayable", "stale_pending_review"]},
          "report_count": {"type": "integer", "minimum": 1},
          "distinct_execution_count": {"type": "integer", "minimum": 1},
          "distinct_actor_count": {"type": "integer", "minimum": 1},
          "distinct_correlation_count": {"type": "integer", "minimum": 1},
          "independent_reproduction_count": {"type": "integer", "minimum": 0},
          "lifecycle": {"type": "string", "minLength": 1},
          "diagnostics": {
            "type": "object",
            "additionalProperties": false,
            "required": ["next_action", "receipt_refs", "runbook_refs"],
            "properties": {
              "next_action": {"type": ["string", "null"]},
              "receipt_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
              "runbook_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
            }
          },
          "reproduction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "attempt_count", "recipe_ref", "last_attempt_ref"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "attempt_count": {"type": "integer", "minimum": 0},
              "recipe_ref": {"type": ["string", "null"]},
              "last_attempt_ref": {"type": ["string", "null"]}
            }
          },
          "resolution": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "fix_refs", "verification_refs", "verified_by"],
            "properties": {
              "status": {"type": "string", "minLength": 1},
              "fix_refs": {"type": "array", "items": {"type": "string"}},
              "verification_refs": {"type": "array", "items": {"type": "string"}},
              "verified_by": {"type": ["string", "null"]}
            }
          },
          "valid_from": {"type": "string", "format": "date-time"},
          "known_at": {"type": "string", "format": "date-time"},
          "source_event_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "policy_hash": {"type": "string", "minLength": 1},
          "window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "occurrence_count", "failure_count", "timeout_count", "partial_count", "success_count", "unknown_count", "distinct_execution_count", "distinct_correlation_count"],
            "properties": {
              "from": {"type": ["string", "null"], "format": "date-time"},
              "to": {"type": ["string", "null"], "format": "date-time"},
              "occurrence_count": {"type": "integer", "minimum": 0},
              "failure_count": {"type": "integer", "minimum": 0},
              "timeout_count": {"type": "integer", "minimum": 0},
              "partial_count": {"type": "integer", "minimum": 0},
              "success_count": {"type": "integer", "minimum": 0},
              "unknown_count": {"type": "integer", "minimum": 0},
              "distinct_execution_count": {"type": "integer", "minimum": 0},
              "distinct_correlation_count": {"type": "integer", "minimum": 0}
            }
          }
        }
      }
    }
  }
}

 "additionalProperties": false,
 "required": [
  "schema",
  "schema_file",
  "hypothesis_notice",
  "generated_at",
  "code_commit",
  "provenance",
  "method",
  "counts",
  "models",
  "routes",
  "unclassified_text_routes"
 ],

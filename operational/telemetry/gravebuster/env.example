# Copy to /srv/agent-telemetry/.env (chmod 600) and fill in. Never commit the real file.
# If you reuse existing Langfuse volumes, SALT / ENCRYPTION_KEY / database credentials MUST match the values
# those volumes were initialised with (API-key hashes depend on SALT).
NEXTAUTH_URL=http://<collector-host>:3000
NEXTAUTH_SECRET=CHANGE_ME
SALT=CHANGE_ME
ENCRYPTION_KEY=CHANGE_ME_64_HEX
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME
REDIS_AUTH=CHANGE_ME
